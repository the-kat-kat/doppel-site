---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
const {
  title = "doppel",
  description = "make your personal slackbot :o",
  image = "/assets/doppel-thumbnail.png",
} = Astro.props;
const imageUrl = new URL(image, Astro.site ?? Astro.url.origin).toString();
const pageUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={pageUrl} />
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-vBsdoAu9PEKLEA8IDnt6c.js"
    ></script>
    <script>
      ((window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        }),
        (plausible.init =
          plausible.init ||
          function (i) {
            plausible.o = i || {};
          }));
      plausible.init();
    </script>
  </head>
  <body>
    <Nav />
    <audio id="bgm" src="/assets/doppel-bgm.mp3" autoplay loop></audio>
    <button
      id="music-toggle"
      type="button"
      aria-label="toggle music"
      aria-pressed="false"
    >
      <svg
        class="icon-on"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 18V5l12-2v13"></path>
        <circle cx="6" cy="18" r="3"></circle>
        <circle cx="18" cy="16" r="3"></circle>
      </svg>
      <svg
        class="icon-off"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 18V5l12-2v13"></path>
        <circle cx="6" cy="18" r="3"></circle>
        <circle cx="18" cy="16" r="3"></circle>
        <line x1="3" y1="3" x2="21" y2="21"></line>
      </svg>
    </button>
    <slot />
    <script>
      const bgm = document.getElementById("bgm") as HTMLAudioElement | null;
      const toggle = document.getElementById("music-toggle");

      const setState = (playing: boolean) => {
        toggle?.setAttribute("aria-pressed", String(playing));
        toggle?.classList.toggle("playing", playing);
      };

      // Reflect real state (autoplay may be blocked by the browser).
      setState(!!bgm && !bgm.paused);
      bgm?.addEventListener("play", () => setState(true));
      bgm?.addEventListener("pause", () => setState(false));

      toggle?.addEventListener("click", () => {
        if (!bgm) return;
        if (bgm.paused) {
          bgm.play().catch(() => setState(false));
        } else {
          bgm.pause();
        }
      });
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  #music-toggle {
    position: fixed;
    top: 7vh;
    right: 2vw;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: none;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.5);
    color: #797ad0;
    cursor: pointer;
    transition:
      background 0.15s ease,
      transform 0.15s ease;
  }
  #music-toggle:hover {
    background: rgba(255, 255, 255, 0.75);
    transform: scale(1.05);
  }
  #music-toggle svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  #music-toggle .icon-off {
    display: none;
  }
  #music-toggle:not(.playing) .icon-on {
    display: none;
  }
  #music-toggle:not(.playing) .icon-off {
    display: block;
  }
</style>
