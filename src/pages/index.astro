---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="relative overflow-hidden">
    <img
      src="/assets/hi-im-doppel.png"
      class="pointer-events-none block w-[70%] mt-32"
    />
    <a href="/join" class="join-btn">
      <img src="/assets/join-me-1.png" class="default block w-[70%]" alt="join" />
      <img src="/assets/join-me-2.png" class="hover-img block w-[70%]" alt="join hover" />
    </a>
    <img
      src="/assets/big-button.png"
      class="pointer-events-none block w-[70%] origin-top pt-16"
    />
  </div>
</Layout>
