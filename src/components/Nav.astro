---
const pathname = Astro.url.pathname;

const links = [
    {href: "", label: "home", src: "/assets/nav/home.png", highlighted: "/assets/nav/home-highlighted.png"},
    {href: "#join", label: "join", src: "/assets/nav/join.png", highlighted: "/assets/nav/join-highlighted.png"},
    {href: "#prizes", label: "prizes", src: "/assets/nav/shop.png", highlighted: "/assets/nav/shop-highlighted.png"},
    {href: "#faq", label: "faq", src: "/assets/nav/faq.png", highlighted: "/assets/nav/faq-highlighted.png"},
];
---

<nav class="fixed flex top-[7vh] left-[2vw] z-100">
   {links.map((link) => (
    <a
      href={link.href}
      class:list={["nav-word", { active: pathname === link.href }]}
    >
      <img src={link.src} class="default" alt={link.label} />
      <img src={link.highlighted} class="highlighted" alt={`${link.label} highlighted`} />
    </a>
  ))}
</nav>

<style>
  .nav-word {
    position: relative;
    display: inline-block;
  }
  .nav-word img {
    display: block;
    width: 70%;
  }
  .nav-word img.highlighted {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .nav-word:hover img.highlighted,
  .nav-word.active img.highlighted {
    opacity: 0.5;
  }
</style>